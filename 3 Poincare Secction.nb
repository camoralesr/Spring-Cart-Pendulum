Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Par\[AAcute]metros"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"mu", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gamma", "=", "0.1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Et", "=", "4"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Regi\[OAcute]n", " ", "de", " ", "condiciones", " ", 
     "iniciales"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xmax", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{"Et", "+", 
         RowBox[{"mu", " ", "gamma"}]}], ")"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vmax", "=", "xmax"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dx", "=", "0.2"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dv", "=", "0.2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xmin", "=", 
     RowBox[{"-", "xmax"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"vmin", "=", 
     RowBox[{"-", "vmax"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Energ\[IAcute]a", " ", "del", " ", "sistema"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"En", "[", 
      RowBox[{"th_", ",", "x_", ",", "w_", ",", "v_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", "mu"}], ")"}], " ", 
       RowBox[{"v", "^", "2"}]}], "+", 
      RowBox[{"mu", " ", "v", " ", "w", " ", 
       RowBox[{"Cos", "[", "th", "]"}]}], "+", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", "mu", " ", 
       RowBox[{"w", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", 
       RowBox[{"x", "^", "2"}]}], "-", 
      RowBox[{"mu", " ", "gamma", " ", 
       RowBox[{"Cos", "[", "th", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "4.", " ", "Velocidad", " ", "angular", " ", "desde", " ", "la", " ", 
     "energ\[IAcute]a"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"rad", "[", 
      RowBox[{"x_", ",", "v_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{"Et", "+", 
           RowBox[{"mu", " ", "gamma"}]}], ")"}]}], "-", 
        RowBox[{"x", "^", "2"}], "-", 
        RowBox[{"v", "^", "2"}]}], ")"}], "/", "mu"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Omega", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", 
       RowBox[{"v_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "ww", "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"rad", "[", 
            RowBox[{"x", ",", "v"}], "]"}], "<", "0"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Missing", "[", "\"\<NoSolution\>\"", "]"}], "]"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"ww", "=", 
         RowBox[{
          RowBox[{"-", "v"}], "+", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"rad", "[", 
            RowBox[{"x", ",", "v"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"ww", ">", "0"}], ",", "ww", ",", 
          RowBox[{"Missing", "[", "\"\<NoSolution\>\"", "]"}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "5.", " ", "Rejilla", " ", "de", " ", "condiciones", " ", "iniciales"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"CI", "=", 
     RowBox[{"DeleteMissing", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"w0", "=", 
              RowBox[{"Omega", "[", 
               RowBox[{"x0", ",", "v0"}], "]"}]}], "}"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"NumericQ", "[", "w0", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"x0", ",", "v0", ",", "w0"}], "}"}], ",", 
              RowBox[{"Missing", "[", "\"\<NoSolution\>\"", "]"}]}], "]"}]}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x0", ",", "xmin", ",", "xmax", ",", "dx"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"v0", ",", "vmin", ",", "vmax", ",", "dv"}], "}"}]}], 
         "]"}], ",", "1"}], "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Condiciones iniciales: \>\"", ",", 
      RowBox[{"Length", "[", "CI", "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"6.", " ", "Ecuaciones", " ", "del", " ", "Spring"}], "-", 
     "Cart", "-", "Pendulum"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SCPeqns", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"v", "[", "t", "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"th", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"w", "[", "t", "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"v", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"mu", " ", 
            RowBox[{
             RowBox[{"w", "[", "t", "]"}], "^", "2"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"th", "[", "t", "]"}], "]"}]}], "+", 
           RowBox[{"mu", " ", "gamma", " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"th", "[", "t", "]"}], "]"}], " ", 
            RowBox[{"Cos", "[", 
             RowBox[{"th", "[", "t", "]"}], "]"}]}], "-", 
           RowBox[{"x", "[", "t", "]"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"mu", " ", 
            RowBox[{
             RowBox[{"Sin", "[", 
              RowBox[{"th", "[", "t", "]"}], "]"}], "^", "2"}]}]}], ")"}]}]}],
        ",", 
       RowBox[{
        RowBox[{
         RowBox[{"w", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], " ", 
            RowBox[{"Cos", "[", 
             RowBox[{"th", "[", "t", "]"}], "]"}]}], "-", 
           RowBox[{"mu", " ", 
            RowBox[{
             RowBox[{"w", "[", "t", "]"}], "^", "2"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"th", "[", "t", "]"}], "]"}], " ", 
            RowBox[{"Cos", "[", 
             RowBox[{"th", "[", "t", "]"}], "]"}]}], "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", "mu"}], ")"}], " ", "gamma", " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"th", "[", "t", "]"}], "]"}]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"mu", " ", 
            RowBox[{
             RowBox[{"Sin", "[", 
              RowBox[{"th", "[", "t", "]"}], "]"}], "^", "2"}]}]}], 
          ")"}]}]}]}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "7.", " ", "Integraci\[OAcute]n", " ", "y", " ", "secci\[OAcute]n", " ", 
     "de", " ", "Poincar\[EAcute]"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Tmax", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"datosPoincare", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x0", ",", "v0", ",", "w0", ",", "sol", ",", "puntos"}], 
          "}"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x0", ",", "v0", ",", "w0"}], "}"}], "=", "ci"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"sol", "=", 
           RowBox[{"Reap", "[", 
            RowBox[{"NDSolve", "[", 
             RowBox[{
              RowBox[{"Join", "[", 
               RowBox[{"SCPeqns", ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"x", "[", "0", "]"}], "==", "x0"}], ",", 
                  RowBox[{
                   RowBox[{"th", "[", "0", "]"}], "==", "0"}], ",", 
                  RowBox[{
                   RowBox[{"v", "[", "0", "]"}], "==", "v0"}], ",", 
                  RowBox[{
                   RowBox[{"w", "[", "0", "]"}], "==", "w0"}], ",", 
                  RowBox[{"WhenEvent", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Sin", "[", 
                    RowBox[{
                    RowBox[{"th", "[", "t", "]"}], "/", "2"}], "]"}], "==", 
                    "0"}], ",", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"t", ">", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&&", 
                    RowBox[{
                    RowBox[{"w", "[", "t", "]"}], ">", "0"}]}], ",", 
                    RowBox[{"Sow", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"x", "[", "t", "]"}], ",", 
                    RowBox[{"v", "[", "t", "]"}]}], "}"}], "]"}]}], "]"}]}], 
                   "]"}]}], "}"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "th", ",", "v", ",", "w"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"t", ",", "0", ",", "Tmax"}], "}"}], ",", 
              RowBox[{"MaxStepSize", "->", "0.01"}], ",", 
              RowBox[{"MaxSteps", "->", "Infinity"}], ",", 
              RowBox[{"AccuracyGoal", "->", "11"}], ",", 
              RowBox[{"PrecisionGoal", "->", "11"}]}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"puntos", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"sol", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}], ">", "0"}], ",", 
             RowBox[{"sol", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "1"}], "]"}], "]"}], ",", 
             RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          "puntos"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"ci", ",", "CI"}], "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Condiciones iniciales: \>\"", ",", 
      RowBox[{"Length", "[", "CI", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Puntos de Poincar\[EAcute]: \>\"", ",", 
      RowBox[{"Total", "[", 
       RowBox[{"Length", "/@", "datosPoincare"}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "8.", " ", "Colores", " ", "por", " ", "condici\[OAcute]n", " ", 
     "inicial"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"colores", "=", 
     RowBox[{"{", 
      RowBox[{
      "Red", ",", "Orange", ",", "Yellow", ",", "Green", ",", "Blue", ",", 
       "Purple"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"estilos", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Directive", "[", 
        RowBox[{
         RowBox[{"colores", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"i", "-", "1"}], ",", 
              RowBox[{"Length", "[", "colores", "]"}]}], "]"}], "+", "1"}], 
           "]"}], "]"}], ",", 
         RowBox[{"PointSize", "[", "0.003", "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "datosPoincare", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"9.", " ", "Gr\[AAcute]fica"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"datosPoincare", ",", 
