Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"ListPlot", "[", 
   RowBox[{"datosPoincare", ",", 
    RowBox[{"PlotStyle", "->", "estilos"}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"Axes", "->", "False"}], ",", 
    RowBox[{"PlotRange", "->", "All"}], ",", 
    RowBox[{"AspectRatio", "->", "1"}], ",", 
    RowBox[{"ImageSize", "->", "500"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[
StyleBox[\"x\", \"TI\"], TraditionalForm], \"errors\" -> {}, \"input\" -> \"x\
\", \"state\" -> \"Boxes\"|>,\"TeXAssistantTemplate\"]\)\>\"", ",", "16"}], 
        "]"}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[
OverscriptBox[
StyleBox[\"x\", \"TI\"], \".\"], TraditionalForm], \"errors\" -> {}, \
\"input\" -> \"\\\\dot{x}\", \"state\" -> \
\"Boxes\"|>,\"TeXAssistantTemplate\"]\)\>\"", ",", "16"}], "]"}]}], "}"}]}], ",", 
    RowBox[{"LabelStyle", "->", "14"}], ",", 
    RowBox[{"Epilog", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Inset", "[", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             
             RowBox[{"\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[\"\[Mu]\", \
TraditionalForm], \"errors\" -> {}, \"input\" -> \"\\\\mu\", \"state\" -> \
\"Boxes\"|>,\"TeXAssistantTemplate\"]\) = \>\"", ",", "mu"}], "}"}], "]"}], ",",
            "14"}], "]"}], ",", 
         RowBox[{"Scaled", "[", 
          RowBox[{"{", 
           RowBox[{"0.98", ",", "0.98"}], "}"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"Right", ",", "Top"}], "}"}]}], "]"}], ",", 
       RowBox[{"Inset", "[", 
        RowBox[{
